<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Color x:Key="Color.SurfacePaper">#F3F1EA</Color>
    <Color x:Key="Color.SurfacePrimary">#FBFAF6</Color>
    <Color x:Key="Color.SurfaceInk">#171A1D</Color>
    <Color x:Key="Color.TextPrimary">#171A1D</Color>
    <Color x:Key="Color.TextSecondary">#6B6C67</Color>
    <Color x:Key="Color.BorderDefault">#CFCBC0</Color>
    <Color x:Key="Color.Signal">#008FD5</Color>
    <Color x:Key="Color.SignalSurface">#DCEFF7</Color>
    <Color x:Key="Color.ActionPrimary">#171A1D</Color>
    <Color x:Key="Color.ActionPrimaryHover">#2A3035</Color>
    <Color x:Key="Color.ActionPrimaryPressed">#0D0F11</Color>
    <Color x:Key="Color.ActionDisabled">#D8D5CD</Color>
    <Color x:Key="Color.ActionTextDisabled">#777873</Color>
    <Color x:Key="Color.Success">#156C52</Color>
    <Color x:Key="Color.SuccessSurface">#DDECE6</Color>
    <Color x:Key="Color.Warning">#8A570C</Color>
    <Color x:Key="Color.WarningSurface">#F5E8C8</Color>
    <Color x:Key="Color.Error">#A33A32</Color>
    <Color x:Key="Color.ErrorSurface">#F8E4E1</Color>
    <Color x:Key="Color.BrandSignalBright">#16B9FF</Color>

    <SolidColorBrush x:Key="Brush.SurfacePaper" Color="{DynamicResource Color.SurfacePaper}" />
    <SolidColorBrush x:Key="Brush.SurfacePrimary" Color="{DynamicResource Color.SurfacePrimary}" />
    <SolidColorBrush x:Key="Brush.SurfaceInk" Color="{DynamicResource Color.SurfaceInk}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.BorderDefault" Color="{DynamicResource Color.BorderDefault}" />
    <SolidColorBrush x:Key="Brush.Signal" Color="{DynamicResource Color.Signal}" />
    <SolidColorBrush x:Key="Brush.SignalSurface" Color="{DynamicResource Color.SignalSurface}" />
    <SolidColorBrush x:Key="Brush.ActionPrimary" Color="{DynamicResource Color.ActionPrimary}" />
    <SolidColorBrush x:Key="Brush.ActionPrimaryHover" Color="{DynamicResource Color.ActionPrimaryHover}" />
    <SolidColorBrush x:Key="Brush.ActionPrimaryPressed" Color="{DynamicResource Color.ActionPrimaryPressed}" />
    <SolidColorBrush x:Key="Brush.ActionDisabled" Color="{DynamicResource Color.ActionDisabled}" />
    <SolidColorBrush x:Key="Brush.ActionTextDisabled" Color="{DynamicResource Color.ActionTextDisabled}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSurface" Color="{DynamicResource Color.SuccessSurface}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSurface" Color="{DynamicResource Color.WarningSurface}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{DynamicResource Color.Error}" />
    <SolidColorBrush x:Key="Brush.ErrorSurface" Color="{DynamicResource Color.ErrorSurface}" />
    <SolidColorBrush x:Key="Brush.BrandSignalBright" Color="{DynamicResource Color.BrandSignalBright}" />

    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Data">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="Type.Display">24</sys:Double>
    <sys:Double x:Key="Type.HeadingLarge">21</sys:Double>
    <sys:Double x:Key="Type.HeadingMedium">17</sys:Double>
    <sys:Double x:Key="Type.Body">12</sys:Double>
    <sys:Double x:Key="Type.Caption">10</sys:Double>
    <sys:Double x:Key="Type.Kicker">9</sys:Double>
    <sys:Double x:Key="Type.Data">11</sys:Double>
    <sys:Double x:Key="Type.DataLarge">18</sys:Double>

    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.5">20</sys:Double>
    <sys:Double x:Key="Space.6">24</sys:Double>
    <sys:Double x:Key="Space.7">28</sys:Double>
    <Thickness x:Key="Inset.2">8</Thickness>
    <Thickness x:Key="Inset.3">12</Thickness>
    <Thickness x:Key="Inset.4">16</Thickness>
    <Thickness x:Key="Inset.5">20</Thickness>
    <Thickness x:Key="Inset.6">24</Thickness>
    <Thickness x:Key="Inset.7">28</Thickness>
    <Thickness x:Key="Inset.Header">28,12</Thickness>
    <CornerRadius x:Key="Radius.Control">2</CornerRadius>
    <CornerRadius x:Key="Radius.Tile">8</CornerRadius>
    <sys:Double x:Key="Size.ControlHeight">38</sys:Double>
    <sys:Double x:Key="Size.PrimaryActionHeight">48</sys:Double>
    <sys:Double x:Key="Size.LedgerRowCompact">54</sys:Double>
    <sys:Double x:Key="Size.LedgerRowComfortable">66</sys:Double>
    <sys:Double x:Key="Size.MonitorLedgerWide">370</sys:Double>
    <sys:Double x:Key="Size.MonitorWorkspaceWide">710</sys:Double>
    <sys:Double x:Key="Size.ConnectionLedgerWide">390</sys:Double>
    <sys:Double x:Key="Size.ConnectionFormWide">700</sys:Double>
    <sys:Double x:Key="Size.ActionPanelWide">320</sys:Double>
    <GridLength x:Key="Size.HeaderHeight">78</GridLength>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
</ResourceDictionary>
