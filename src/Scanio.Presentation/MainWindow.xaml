<Window x:Class="Scanio.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Scanio.Presentation.Views"
        Title="Сканио" Icon="Assets/scanio.ico"
        Width="1440" Height="900" MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{DynamicResource Size.HeaderHeight}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.TextPrimary}" BorderThickness="0,0,0,2"
                Padding="{DynamicResource Inset.Header}" Background="{DynamicResource Brush.SurfacePrimary}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/scanio-logo-ru.png" Width="160" HorizontalAlignment="Left" Stretch="Uniform" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="ConnectionNavigation" Content="Подключение" Click="ShowConnection" Style="{DynamicResource CommandButton}" Margin="4,0" />
                    <Button x:Name="MonitorNavigation" Content="Монитор" Click="ShowMonitor" Style="{DynamicResource CommandButton}" Margin="4,0" />
                    <Button x:Name="NotebookNavigation" Content="Блокнот" Click="ShowNotebook" Style="{DynamicResource CommandButton}" Margin="4,0" />
                    <Button x:Name="HistoryNavigation" Content="История" Click="ShowHistory" Style="{DynamicResource CommandButton}" Margin="4,0" />
                    <Button Content="Настройки" IsEnabled="False" Style="{DynamicResource CommandButton}" Margin="4,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Monitor.ConnectionLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Отключить" Command="{Binding Monitor.DisconnectCommand}" Style="{DynamicResource CommandButton}" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <views:ConnectionView x:Name="ConnectionScreen" DataContext="{Binding Connection}" />
            <views:MonitorView x:Name="MonitorScreen" DataContext="{Binding Monitor}" Visibility="Collapsed" />
            <views:NotebookView x:Name="NotebookScreen" DataContext="{Binding Notebook}" Visibility="Collapsed" />
            <views:HistoryView x:Name="HistoryScreen" DataContext="{Binding History}" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
