<UserControl x:Class="Scanio.Presentation.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource Brush.SurfacePrimary}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="26*" /><ColumnDefinition Width="50*" /><ColumnDefinition Width="24*" /></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Brush.SurfacePaper}" BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="0,0,1,0" Padding="{DynamicResource Inset.4}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="ЖИВАЯ ЛЕНТА" Style="{DynamicResource KickerText}" />
                <DockPanel Grid.Row="1" Margin="0,8,0,12">
                    <TextBlock Text="Сканы" Style="{DynamicResource PanelTitle}" />
                    <Button Content="К последнему" Command="{Binding ReturnToLatestCommand}" Style="{DynamicResource CommandButton}" DockPanel.Dock="Right"
                            Visibility="{Binding ShowReturnToLatest, Converter={StaticResource BooleanToVisibility}}" />
                </DockPanel>
                <ListView Grid.Row="2" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#" DisplayMemberBinding="{Binding Sequence}" Width="44" />
                            <GridViewColumn Header="Время" DisplayMemberBinding="{Binding Timestamp}" Width="92" />
                            <GridViewColumn Header="Данные" DisplayMemberBinding="{Binding Payload}" Width="150" />
                            <GridViewColumn Header="Тип" DisplayMemberBinding="{Binding Format}" Width="90" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Выбранный скан" Style="{DynamicResource PageTitle}" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,16">
                <StackPanel>
                    <TextBlock Text="PAYLOAD" Style="{DynamicResource KickerText}" />
                    <TextBlock Text="{Binding SelectedEvent.Payload, TargetNullValue=Ожидание первого скана…}" FontFamily="{DynamicResource Font.Data}" FontSize="{DynamicResource Type.DataLarge}" TextWrapping="Wrap" Margin="0,8,0,20" />
                    <Border Background="{DynamicResource Brush.SurfaceInk}" Padding="{DynamicResource Inset.4}">
                        <StackPanel>
                            <TextBlock Text="RAW" Foreground="{DynamicResource Brush.Signal}" Style="{DynamicResource KickerText}" />
                            <TextBlock Text="{Binding SelectedEvent.Raw}" Foreground="{DynamicResource Brush.SurfacePrimary}" FontFamily="{DynamicResource Font.Data}" TextWrapping="Wrap" Margin="0,6,0,12" />
                            <TextBlock Text="HEX" Foreground="{DynamicResource Brush.Signal}" Style="{DynamicResource KickerText}" />
                            <TextBlock Text="{Binding SelectedEvent.Hex}" Foreground="{DynamicResource Brush.SurfacePrimary}" FontFamily="{DynamicResource Font.Data}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="1" Padding="{DynamicResource Inset.4}" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="ФАКТ" Style="{DynamicResource KickerText}" /><TextBlock Text="{Binding SelectedEvent.Completion}" Margin="0,8,0,0" /><TextBlock Text="{Binding SelectedEvent.ByteCount, StringFormat={}{0} байт}" /></StackPanel>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="1" Padding="{DynamicResource Inset.4}" Margin="8,0,0,0">
                            <StackPanel><TextBlock Text="ИНТЕРПРЕТАЦИЯ" Style="{DynamicResource KickerText}" /><TextBlock Text="{Binding SelectedEvent.Format}" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="{Binding SelectedEvent.Evidence}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" /></StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="RAW и HEX — первичные данные. Формат — интерпретация анализатора." Foreground="{DynamicResource Brush.TextSecondary}" />
        </Grid>

        <Border Grid.Column="2" Background="{DynamicResource Brush.SurfacePaper}" BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="1,0,0,0" Padding="{DynamicResource Inset.4}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="КОНТЕКСТ" Style="{DynamicResource KickerText}" />
                <TextBlock Grid.Row="1" Text="{Binding ConnectionLabel}" Style="{DynamicResource PanelTitle}" TextWrapping="Wrap" Margin="0,8,0,20" />
                <ListView Grid.Row="2" ItemsSource="{Binding SelectedEvent.Chunks}" VirtualizingPanel.IsVirtualizing="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Sequence, StringFormat=Chunk #{0}}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding HexPreview}" Style="{DynamicResource DataText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ByteCount, StringFormat={}{0} байт}" Foreground="{DynamicResource Brush.TextSecondary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
