<UserControl x:Class="Scanio.Presentation.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:Scanio.Presentation.Localization">
    <UserControl.InputBindings>
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCodeCommand}" />
    </UserControl.InputBindings>
    <Grid Background="{DynamicResource Brush.SurfacePrimary}" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370*" />
            <ColumnDefinition Width="710*" />
            <ColumnDefinition Width="360*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Brush.SurfacePaper}"
                BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="0,0,1,0"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.Live]}" Style="{DynamicResource KickerText}" />
                <Grid Grid.Row="1" Margin="0,8,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.Scans]}" Style="{DynamicResource PanelTitle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.Latest]}" Command="{Binding ReturnToLatestCommand}"
                            Style="{DynamicResource QuietButton}"
                            Visibility="{Binding ShowReturnToLatest, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
                <ListBox Grid.Row="2" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                         Style="{DynamicResource LedgerListBox}"
                         ItemContainerStyle="{DynamicResource LedgerRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Sequence, StringFormat=№{0}}" Style="{DynamicResource DataText}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Timestamp}" Margin="10,0,0,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Format}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                                    <TextBlock Text="{Binding DuplicateCount, StringFormat= ×{0}}" Margin="5,0,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Payload}"
                                           FontFamily="{DynamicResource Font.Data}" TextTrimming="CharacterEllipsis"
                                           Margin="0,6,0,0" ToolTip="{Binding Payload}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,20" MinWidth="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedEvent.Sequence, StringFormat=#{0}, TargetNullValue=—}"
                               Style="{DynamicResource KickerText}" />
                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.Title]}"
                               Style="{DynamicResource PageTitle}" TextWrapping="Wrap" Margin="0,5,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding CopyFeedback}" Foreground="{DynamicResource Brush.Success}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.CopyCode]}" Command="{Binding CopyCodeCommand}"
                            Style="{DynamicResource PrimaryButton}" MinWidth="142" />
                    <Menu Margin="8,0,0,0" Background="Transparent" VerticalAlignment="Center">
                        <MenuItem Header="•••" FontWeight="Bold">
                            <MenuItem Header="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.CopyRaw]}" Command="{Binding DataContext.CopyRawCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <MenuItem Header="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.CopyHex]}" Command="{Binding DataContext.CopyHexCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Separator />
                            <MenuItem Header="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.CopyJson]}" Command="{Binding DataContext.CopyDiagnosticJsonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource Brush.SurfacePaper}"
                    BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="1"
                    Padding="16" Margin="0,16,0,12">
                <StackPanel>
                    <TextBlock Text="PAYLOAD" Style="{DynamicResource KickerText}" />
                    <TextBlock Text="{Binding SelectedEvent.Payload, TargetNullValue=—}"
                               FontFamily="{DynamicResource Font.Data}" FontSize="{DynamicResource Type.DataLarge}"
                               TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="RawEvidence" Grid.Row="2" Background="{DynamicResource Brush.SurfaceInk}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="RAW" Foreground="{DynamicResource Brush.Signal}" Style="{DynamicResource KickerText}" />
                        <TextBlock Text="{Binding SelectedEvent.Raw}" Foreground="{DynamicResource Brush.SurfacePrimary}"
                                   FontFamily="{DynamicResource Font.Data}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="56" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="HEX" Foreground="{DynamicResource Brush.Signal}" Style="{DynamicResource KickerText}" />
                        <TextBlock Text="{Binding SelectedEvent.Hex}" Foreground="{DynamicResource Brush.SurfacePrimary}"
                                   FontFamily="{DynamicResource Font.Data}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="56" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.Fact]}" Style="{DynamicResource KickerText}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding SelectedEvent.Completion}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedEvent.ByteCount, StringFormat={}{0} B}"
                                       Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="108" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.Interpretation]}" Style="{DynamicResource KickerText}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding SelectedEvent.Format}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedEvent.Confidence}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer x:Name="AnalysisScroll" Grid.Row="4" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                <ItemsControl ItemsSource="{Binding SelectedEvent.Analyses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="1"
                                    Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Format}" Style="{DynamicResource PanelTitle}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding Confidence}" Margin="12,2,0,0"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                    <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Margin="0,4,0,10"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <ItemsControl ItemsSource="{Binding Fields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{DynamicResource Font.Data}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Errors}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Error}" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="5" Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.Footer]}"
                       Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,0" />
        </Grid>

        <Border Grid.Column="2" Background="{DynamicResource Brush.SurfacePaper}"
                BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="1,0,0,0"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.Inspector]}" Style="{DynamicResource KickerText}" />
                <Border x:Name="ConnectionInspector" Grid.Row="1" Style="{DynamicResource InspectorSection}" Margin="0,10,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.Connection]}" Style="{DynamicResource PanelTitle}" />
                        <TextBlock Text="{Binding ConnectionLabel}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding ConnectionFriendlyName}" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Text="{Binding ConnectionSnapshot.ParametersLabel}" FontFamily="{DynamicResource Font.Data}"
                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <Border x:Name="MeasurementInspector" Grid.Row="2" Style="{DynamicResource InspectorSection}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.Measurement]}" Style="{DynamicResource PanelTitle}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.Started]}" Style="{DynamicResource KeyValueLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEvent.StartedAt}" Style="{DynamicResource KeyValueValue}" />
                        <TextBlock Grid.Row="2" Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.Ended]}" Style="{DynamicResource KeyValueLabel}" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEvent.EndedAt}" Style="{DynamicResource KeyValueValue}" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="3" Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.Duration]}" Style="{DynamicResource KeyValueLabel}" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedEvent.Duration}" Style="{DynamicResource KeyValueValue}" Margin="0,5,0,0" />
                    </Grid>
                </Border>
                <Grid x:Name="ChunksInspector" Grid.Row="3">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Monitor.Reads]}" Style="{DynamicResource PanelTitle}" Margin="0,0,0,8" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding SelectedEvent.Chunks}" Style="{DynamicResource LedgerListBox}"
                             ItemContainerStyle="{DynamicResource AdaptiveRecordRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Sequence, StringFormat=#{0}}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Interval}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <TextBlock Grid.Row="1" Text="{Binding HexPreview}" Style="{DynamicResource DataText}"
                                               TextTrimming="CharacterEllipsis" Margin="0,4,8,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ByteCount, StringFormat={}{0} B}"
                                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
