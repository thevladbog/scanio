<UserControl x:Class="Scanio.Presentation.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:notebook="clr-namespace:Scanio.Application.Notebook;assembly=Scanio.Application">
    <Grid Background="{DynamicResource Brush.SurfacePrimary}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Brush.SurfacePaper}" BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="0,0,1,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="История" Style="{DynamicResource PageTitle}" />
                <Button Grid.Row="1" Content="Обновить" Command="{Binding RefreshCommand}" Style="{DynamicResource CommandButton}" HorizontalAlignment="Left" Margin="0,14,0,14" />
                <ListView Grid.Row="2" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" VirtualizingPanel.IsVirtualizing="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1" Foreground="{DynamicResource Brush.TextSecondary}">
                                    <Run Text="{Binding StartedAt}" /><Run Text=" · " /><Run Text="{Binding RecordCount}" /><Run Text=" сканов" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Открыть" Command="{Binding OpenCommand}" Style="{DynamicResource PrimaryButton}" />
                        <Button Content="Переименовать" Command="{Binding RenameCommand}" Style="{DynamicResource CommandButton}" Margin="8,0,0,0" />
                        <Button Content="Удалить" Command="{Binding DeleteCommand}" Style="{DynamicResource CommandButton}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Сохранённые сканы" Style="{DynamicResource PageTitle}" />
                    <TextBlock Text="Выберите сессию слева и нажмите «Открыть»." Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,6,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedExportFormat}" SelectedValuePath="Tag" VerticalAlignment="Center">
                    <ComboBoxItem Content="TXT" Tag="{x:Static notebook:NotebookExportFormat.Text}" />
                    <ComboBoxItem Content="CSV" Tag="{x:Static notebook:NotebookExportFormat.Csv}" />
                    <ComboBoxItem Content="JSON" Tag="{x:Static notebook:NotebookExportFormat.Json}" />
                </ComboBox>
                <Button Grid.Column="2" Content="Копировать" Command="{Binding CopyCommand}" Style="{DynamicResource CommandButton}" Margin="8,0,0,0" />
                <Button Grid.Column="3" Content="Экспорт" Command="{Binding ExportCommand}" Style="{DynamicResource CommandButton}" Margin="8,0,0,0" />
            </Grid>
            <ListView Grid.Row="1" ItemsSource="{Binding Records}" Margin="0,20,0,0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="#" DisplayMemberBinding="{Binding Sequence}" Width="50" />
                        <GridViewColumn Header="Время" DisplayMemberBinding="{Binding Timestamp}" Width="90" />
                        <GridViewColumn Header="Код" DisplayMemberBinding="{Binding Payload}" Width="230" />
                        <GridViewColumn Header="Формат" DisplayMemberBinding="{Binding Format}" Width="110" />
                        <GridViewColumn Header="Сканер" DisplayMemberBinding="{Binding Transport}" Width="100" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
