<UserControl x:Class="Scanio.Presentation.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource Brush.SurfacePrimary}" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390*" />
            <ColumnDefinition Width="730*" />
            <ColumnDefinition Width="320*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Brush.SurfacePaper}" BorderBrush="{DynamicResource Brush.BorderDefault}"
                BorderThickness="0,0,1,0" Padding="18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ИСТОРИЯ" Style="{DynamicResource KickerText}" />
                        <TextBlock Text="Сохранённые сессии" Style="{DynamicResource PageTitle}" Margin="0,5,0,14" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}"
                            Style="{DynamicResource QuietButton}" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                         Style="{DynamicResource LedgerListBox}" ItemContainerStyle="{DynamicResource LedgerRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                <TextBlock Grid.Column="1" Text="{Binding RecordCount, StringFormat={}{0} сканов}"
                                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="8,0,0,0" />
                                <TextBlock Grid.Row="1" Text="{Binding StartedAt}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,5,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Duration}"
                                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="8,5,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" />
                    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                        <Button Content="Открыть" Command="{Binding OpenCommand}" Style="{DynamicResource PrimaryButton}" />
                        <Button Content="Переименовать" Command="{Binding RenameCommand}" Style="{DynamicResource SecondaryButton}" Margin="8,0,0,0" />
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="20,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ВЫБРАННАЯ СЕССИЯ" Style="{DynamicResource KickerText}" />
                    <TextBlock Text="{Binding SelectedSession.Name, TargetNullValue=Выберите сессию}" Style="{DynamicResource PageTitle}"
                               TextTrimming="CharacterEllipsis" Margin="0,5,12,14" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding RecordCount, StringFormat={}{0} записей}"
                           Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,16" />
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding Records}" Style="{DynamicResource LedgerListBox}"
                     ItemContainerStyle="{DynamicResource AdaptiveRecordRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Sequence}" Style="{DynamicResource DataText}" />
                            <TextBlock Grid.Column="1" Text="{Binding Timestamp}" Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Grid.Column="2" Text="{Binding Payload}" FontFamily="{DynamicResource Font.Data}"
                                       TextTrimming="CharacterEllipsis" Margin="8,0,12,0" ToolTip="{Binding Payload}" />
                            <TextBlock Grid.Column="3" Text="{Binding Format}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{Binding DuplicateCount, StringFormat=×{0}}"
                                       HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Column="2" Background="{DynamicResource Brush.SurfacePaper}"
                BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="1,0,0,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="ДЕЙСТВИЯ" Style="{DynamicResource KickerText}" />
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Копировать" Style="{DynamicResource PanelTitle}" Margin="0,8,0,14" />
                    <Button Content="Все значения" Command="{Binding CopyAllCommand}" Style="{DynamicResource SecondaryButton}" />
                    <Button Content="Только уникальные" Command="{Binding CopyUniqueCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,8,0,0" />
                    <Button Content="С управляющими символами" Command="{Binding CopyEscapedCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,8,0,0" />
                    <Border BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="0,1,0,0" Margin="0,24,0,20" />
                    <TextBlock Text="Экспорт" Style="{DynamicResource PanelTitle}" Margin="0,0,0,14" />
                    <Button Content="Экспорт TXT" Command="{Binding ExportTextCommand}" Style="{DynamicResource SecondaryButton}" />
                    <Button Content="Экспорт CSV" Command="{Binding ExportCsvCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,8,0,0" />
                    <Button Content="Диагностический JSON" Command="{Binding ExportJsonCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,8,0,0" />
                </StackPanel>
                <Button Grid.Row="3" Content="Удалить выбранную сессию" Command="{Binding DeleteCommand}"
                        Style="{DynamicResource DangerButton}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
