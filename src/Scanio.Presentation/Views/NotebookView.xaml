<UserControl x:Class="Scanio.Presentation.Views.NotebookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:Scanio.Presentation.Localization">
    <Grid Background="{DynamicResource Brush.SurfacePrimary}" ClipToBounds="True">
        <Grid.RowDefinitions><RowDefinition Height="92" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.Active]}" Style="{DynamicResource KickerText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox Text="{Binding SessionName, UpdateSourceTrigger=PropertyChanged}" Width="300"
                                 VerticalContentAlignment="Center" />
                        <Border Background="{DynamicResource Brush.SignalSurface}" BorderBrush="{DynamicResource Brush.Signal}"
                                BorderThickness="1" Padding="12,8" Margin="12,0,0,0">
                            <TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.Start]}" Command="{Binding StartCommand}" Style="{DynamicResource PrimaryButton}"
                            Visibility="{Binding IsOff, Converter={StaticResource BooleanToVisibility}}" />
                    <Button Content="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.Pause]}" Command="{Binding PauseCommand}" Style="{DynamicResource SecondaryButton}"
                            Visibility="{Binding IsRecording, Converter={StaticResource BooleanToVisibility}}" />
                    <Button Content="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.Resume]}" Command="{Binding ResumeCommand}" Style="{DynamicResource PrimaryButton}"
                            Visibility="{Binding IsPaused, Converter={StaticResource BooleanToVisibility}}" />
                    <Button Content="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.Stop]}" Command="{Binding StopCommand}" Style="{DynamicResource DangerButton}"
                            Margin="8,0,0,0"
                            Visibility="{Binding CanStop, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300*" />
                <ColumnDefinition Width="820*" />
                <ColumnDefinition Width="320*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource Brush.SurfacePaper}" BorderBrush="{DynamicResource Brush.BorderDefault}"
                    BorderThickness="0,0,1,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.Session]}" Style="{DynamicResource KickerText}" />
                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.Summary]}" Style="{DynamicResource PanelTitle}" Margin="0,8,0,22" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.Total]}" Style="{DynamicResource KeyValueLabel}" />
                        <TextBlock Grid.Column="1" Text="{Binding TotalCount}" FontFamily="{DynamicResource Font.Data}" FontSize="18" />
                        <TextBlock Grid.Row="1" Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.Unique]}" Style="{DynamicResource KeyValueLabel}" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UniqueCount}" FontFamily="{DynamicResource Font.Data}" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="2" Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.Duplicates]}" Style="{DynamicResource KeyValueLabel}" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DuplicateCount}" FontFamily="{DynamicResource Font.Data}" Margin="0,12,0,0" />
                    </Grid>
                    <Border Style="{DynamicResource InspectorSection}" Margin="0,28,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.Scanner]}" Style="{DynamicResource KickerText}" />
                            <TextBlock Text="{Binding DeviceLabel}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.LocalNotice]}" Foreground="{DynamicResource Brush.TextSecondary}"
                               TextWrapping="Wrap" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="20,18">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.Recorded]}" Style="{DynamicResource KickerText}" />
                        <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.Title]}" Style="{DynamicResource PageTitle}" Margin="0,5,0,14" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding TotalCount}"
                               Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,16" />
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding Records}" Style="{DynamicResource LedgerListBox}"
                         ItemContainerStyle="{DynamicResource AdaptiveRecordRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="5" IsHitTestVisible="False" Opacity="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsArrivalPulseActive}" Value="True" />
                                                        <Condition Binding="{Binding IsDuplicate}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{DynamicResource Brush.SignalSurface}" />
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.6" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsArrivalPulseActive}" Value="True" />
                                                        <Condition Binding="{Binding IsDuplicate}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{DynamicResource Brush.WarningSurface}" />
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.6" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding Sequence}" Style="{DynamicResource DataText}" />
                                <TextBlock Grid.Column="1" Text="{Binding Timestamp}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                <TextBlock Grid.Column="2" Text="{Binding Payload}" FontFamily="{DynamicResource Font.Data}"
                                           TextTrimming="CharacterEllipsis" Margin="8,0,12,0" ToolTip="{Binding Payload}" />
                                <TextBlock Grid.Column="3" Text="{Binding Format}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{Binding DuplicateCount, StringFormat=×{0}}"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Error}"
                           Margin="0,10,0,0" TextWrapping="Wrap" />
            </Grid>

            <Border Grid.Column="2" Background="{DynamicResource Brush.SurfacePaper}"
                    BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="1,0,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.Actions]}" Style="{DynamicResource KickerText}" />
                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.Copy]}" Style="{DynamicResource PanelTitle}" Margin="0,8,0,14" />
                    <Button Content="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.CopyAll]}" Command="{Binding CopyAllCommand}" Style="{DynamicResource SecondaryButton}" />
                    <Button Content="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.CopyUnique]}" Command="{Binding CopyUniqueCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,8,0,0" />
                    <Button Content="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.CopyEscaped]}" Command="{Binding CopyEscapedCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,8,0,0" />
                    <Border BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="0,1,0,0" Margin="0,24,0,20" />
                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.Export]}" Style="{DynamicResource PanelTitle}" Margin="0,0,0,14" />
                    <Button Content="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.ExportText]}" Command="{Binding ExportTextCommand}" Style="{DynamicResource SecondaryButton}" />
                    <Button Content="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.ExportReadableText]}" Command="{Binding ExportReadableTextCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,8,0,0" />
                    <Button Content="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.ExportCsv]}" Command="{Binding ExportCsvCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,8,0,0" />
                    <Button Content="{Binding Source={x:Static localization:LocalizationSource.Current}, Path=[Notebook.ExportJson]}" Command="{Binding ExportJsonCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
