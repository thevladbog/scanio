<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scanio.Presentation\Scanio.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\Scanio.Presentation\MainWindow.xaml"
          Link="LayoutContracts\MainWindow.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Scanio.Presentation\Resources\Theme.xaml"
          Link="LayoutContracts\Theme.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Scanio.Presentation\Resources\Controls.xaml"
          Link="LayoutContracts\Controls.xaml"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
